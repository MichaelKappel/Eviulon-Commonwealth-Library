Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(data|src|tests|tools|private)(/|$) - [F,L,NC]
RewriteRule ^(?:\.uai|\.git)(/|$) - [F,L,NC]
RewriteRule ^(?:README_DEPLOY|QA_REPORT|CHANGELOG)\.md$ - [F,L,NC]
# v3.14.8: Only QUERY-FREE immutable public catalogs are served directly.
# Any query parameters (including future format/edition filters) go to PHP.
# v3.13: Immutable-for-release public catalogs are served directly as files.
# No PHP bootstrap/JSON decode/monitor lock on high-traffic GET/HEAD catalog routes.
# Source metadata and research section text remain protected in data/.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^api/v1/$ api-cache/v1/index.json [L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^api/v1/books/$ api-cache/v1/books.json [L]
# Only the no-query research catalog is static. page/limit still use PHP.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^api/v1/research/$ api-cache/v1/research-index.json [L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/api-cache/v1/toc/$1.json -f
RewriteRule ^api/v1/books/([a-z0-9-]+)/toc/$ api-cache/v1/toc/$1.json [L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/api-cache/v1/books/$1.json -f
RewriteRule ^api/v1/books/([a-z0-9-]+)/$ api-cache/v1/books/$1.json [L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/api-cache/v1/research/$1/$2.json -f
RewriteRule ^api/v1/research/(eviulon|evulgare)/([a-z0-9-]+)/$ api-cache/v1/research/$1/$2.json [L]
# v3.14.5: 3,478 fixed citation-metadata responses served as static JSON.
# Canonical references contain NO manuscript/report body text. Preserve dynamic
# error handling, non-GET methods and future query-sensitive behavior.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/api-cache/v1/citations/books/$1/$2.json -f
RewriteRule ^api/v1/books/([a-z0-9-]+)/citations/([1-9][0-9]*)/$ api-cache/v1/citations/books/$1/$2.json [L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/api-cache/v1/citations/research/$1/$2/$3.json -f
RewriteRule ^api/v1/research/(eviulon|evulgare)/([a-z0-9-]+)/parts/([1-9][0-9]*)/citation/$ api-cache/v1/citations/research/$1/$2/$3.json [L]
# v3.14.6: Canonical reading HTML, generated byte-for-byte by the release's PHP renderer.
# Direct access to the storage path is forbidden; only canonical routes are indexable.
# THE_REQUEST is the ORIGINAL browser request, allowing internal rewrites to the cache.
# Also reject percent-encoded direct requests. Internal static rewrites carry
# REDIRECT_STATUS; direct requests do not, regardless of encoded spellings.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^html-cache(?:/|$) - [F,L]
RewriteCond %{THE_REQUEST} "\s/+html-cache(?:/|[?[:space:]])" [NC]
RewriteRule ^html-cache(?:/|$) - [F,L]
# Non-GET/HEAD and any query parameter always use the dynamic PHP handler.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/html-cache/research/$1/$2/$3.html -f
RewriteRule ^research/(eviulon|evulgare)/([a-z0-9-]+)/([1-9][0-9]*)/$ html-cache/research/$1/$2/$3.html [L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/html-cache/research/$1/$2/landing.html -f
RewriteRule ^research/(eviulon|evulgare)/([a-z0-9-]+)/$ html-cache/research/$1/$2/landing.html [L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/html-cache/books/$1/$2.html -f
RewriteRule ^([a-z0-9-]+)/([1-9][0-9]*)/$ html-cache/books/$1/$2.html [L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/html-cache/books/$1/landing.html -f
RewriteRule ^([a-z0-9-]+)/$ html-cache/books/$1/landing.html [L]
# v3.14.9 source-grounded lexical topics: canonical query-free HTML is static.
# Prevent public direct access to generated topic snapshot internals.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^topics-cache(?:/|$) - [F,L]
RewriteCond %{THE_REQUEST} "\s/+topics-cache(?:/|[?[:space:]])" [NC]
RewriteRule ^topics-cache(?:/|$) - [F,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^topics/$ topics-cache/index.html [L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/topics-cache/$1.html -f
RewriteRule ^topics/([a-z0-9-]+)/$ topics-cache/$1.html [L]
# Discovery resources exist as deploy-time static files. GET/HEAD requests
# bypass PHP; unsupported methods retain the legacy non-cacheable JSON 405.
RewriteCond %{REQUEST_METHOD} !^(?:GET|HEAD)$
RewriteRule ^(?:robots\.txt|llms\.txt|sitemap(?:-[A-Za-z0-9-]+)?\.xml|ai/knowledge\.json|ai/source-registry\.jsonld|ai/discovery-attestation\.json|openapi\.json|feeds/books\.atom)$ index.php [L,QSA,NC]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L,QSA]
# Keep discovery resources fast and independently cacheable on LiteSpeed.
# Real ETag / Last-Modified for static files are emitted by the web server.
AddType application/atom+xml .atom
AddType application/ld+json .jsonld
<FilesMatch "^(?:robots\.txt|llms\.txt|openapi\.json|knowledge\.json|static-delivery\.json|concepts\.json|source-registry\.jsonld|discovery-attestation\.json|books\.atom|sitemap(?:-[A-Za-z0-9-]+)?\.xml)$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Static-delivery inventory: direct public manifest, never PHP-rendered.
<FilesMatch "^static-delivery\.json$">
  <IfModule mod_headers.c>
    Header always set X-Eviulon-Delivery "prebuilt-static-json"
    Header always set Access-Control-Allow-Origin "*"
    Header always set X-Robots-Tag "noindex"
  </IfModule>
</FilesMatch>
