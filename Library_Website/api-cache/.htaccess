# Safe public metadata only. Never place source text, secrets, or private records here.
Options -Indexes
AddType application/json .json
AddCharset UTF-8 .json
<IfModule mod_headers.c>
  Header always set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
  Header always set Access-Control-Allow-Origin "*"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Eviulon-Delivery "prebuilt-static-json"
  Header always set X-Robots-Tag "noindex"
  Header always set Link "<https://library.eviulon.com/openapi.json>; rel=\"service-desc\"; type=\"application/json\""
</IfModule>
