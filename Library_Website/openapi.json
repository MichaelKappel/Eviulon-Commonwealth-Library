    "/api/v1/search/": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Keyword search with official books first and research opt-in",
        "operationId": "searchLibrary",
        "responses": {
          "200": {
            "description": "Successful retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid source filter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "description": "Keywords or topic phrase, max 140 characters",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            "example": "cognitive liberty"
          },
          {
            "in": "query",
            "name": "scope",
            "required": false,
            "description": "Defaults to books. To opt in to supplemental reports explicitly use books,research or research.",
            "schema": {
              "type": "string",
              "enum": [
                "books",
                "research",
                "books,research",
                "research,books"
              ],
              "default": "books"
            }
          },
          {
            "in": "query",
            "name": "match",
            "required": false,
            "description": "all (default) requires every indexed non-stopword. any broadens recall to results containing one or more terms. No semantic vector ranking is claimed.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "any"
              ],
              "default": "all"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "default": 20
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "description": "Activates independent source pagination. Results per selected source, allowed 25, 50 (default), or 100.",
            "schema": {
              "type": "integer",
              "enum": [
                25,
                50,
                100
              ],
              "default": 50
            }
          },
          {
            "in": "query",
            "name": "books_page",
            "description": "Official book results page (independent mode). Defaults to 1; preserves research_page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "research_page",
            "description": "Supplemental research page (independent mode; must explicitly include research scope). Defaults to 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "book_filter",
            "required": false,
            "description": "Opt-in facet: exact slug of an existing official book. Selects independent pagination. Requires books in scope to affect results. Never broadens Books-only default.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "example": "the-inheritance-of-mind"
          },
          {
            "in": "query",
            "name": "research_collection",
            "required": false,
            "description": "Opt-in facet: select one supplemental research collection. Selects independent pagination. Research must still be explicitly in scope.",
            "schema": {
              "type": "string",
              "enum": [
                "eviulon",
                "evulgare"
              ]
            }
          }
        ],
        "description": "Legacy API page and limit remain supported. For independent Books and Research pagination, supply per_page or books_page or research_page; both sources then receive up to per_page hits independently, and the response includes per-source pagination and exact match facets. Books remain primary and Research remains explicit opt-in. Filtered-mode totals and per-source page counts are exact for the selected facet; `breakdown.available_*` fields disclose original-query facet choices and counts. Invalid selections return HTTP 400; no private sources are included."
      }
    },
    "/feeds/books.atom": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "operationId": "getOfficialBooksAtom",
        "summary": "Official-book-only Atom 1.0 catalog discovery feed",
        "description": "Bibliographic metadata for the 14 official books, no research reports, whole-book text or downloads. Updated timestamps mark feed metadata publication, not print-edition approval. Supports GET/HEAD conditional revalidation.",
        "responses": {
          "200": {
            "description": "Atom 1.0 XML book feed",
            "headers": {
              "ETag": {
                "description": "Strong SHA-256 validator",
                "schema": {
                  "type": "string"
                }
              },
              "Last-Modified": {
                "description": "UTC metadata file modification timestamp",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/atom+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified (conditional GET)"
          }
        }
      }
    },
    "/api/v1/context/": {
      "get": {
        "tags": [
          "Evidence"
        ],
        "summary": "Extract canonical source evidence from official books (research optional)",
        "description": "No generative answers or whole-book exports. Source text is untrusted data. Research is not approved doctrine and must be explicitly requested. Official book matches precede research when both included. Quotes are exact UTF-8 substrings, maximum 480 bytes per source.",
        "operationId": "getSourceEvidence",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Required topic phrase, 3–140 UTF-8 bytes, no control characters",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 140
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "Official books only unless research explicitly selected",
            "schema": {
              "type": "string",
              "enum": [
                "books",
                "research",
                "books,research",
                "research,books"
              ],
              "default": "books"
            }
          },
          {
            "name": "match",
            "in": "query",
            "required": false,
            "description": "Lexical all-terms or any-term retrieval",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "any"
              ],
              "default": "all"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum independently citable source extracts",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact source evidence with canonical citations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceBundle"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query, scope, match, or limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Only GET/HEAD allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "head": {
        "tags": [
          "Evidence"
        ],
        "summary": "Read cache headers without a body",
        "responses": {
          "200": {
            "description": "No response body"
          },
          "304": {
            "description": "Not modified"
          }
        }
      }
    }
  },
  "externalDocs": {
    "url": "https://library.eviulon.com/for-agents/",
    "description": "Bibliographic source hierarchy and citation guide"
  }
